{
  "name": "beamloom",
  "version": "0.1.11",
  "description": "Projection mapping studio for Windows",
  "author": "Chad Kennedy",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --open false",
    "build": "npm run check:electron && tsc --noEmit && vite build",
    "check:electron": "node scripts/check-electron.cjs",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "make:win": "npm run build && electron-forge make --platform win32 --arch x64"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
